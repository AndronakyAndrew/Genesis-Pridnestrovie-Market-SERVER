<Project>
  <!-- Общие настройки для всех проектов решения -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet-аудит (NU19xx) оставляем видимым как предупреждение, но не роняем
         им сборку: для части транзитивных зависимостей патченой версии на фиде
         пока нет. Ошибки компилятора по-прежнему трактуются как ошибки. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
