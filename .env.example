# ============================================================
#  Genesis Market — пример переменных окружения.
#  Скопируй в .env и заполни значения. .env в .gitignore.
#  ООО «Genesis Industries Corp»
# ============================================================

# ---- ASP.NET Core ----
# Development включает Swagger. В Production Swagger отключён полностью.
ASPNETCORE_ENVIRONMENT=
# Порт, который слушает Kestrel ВНУТРИ контейнера (default 8080).
ASPNETCORE_HTTP_PORTS=

# Минимальный уровень логирования Serilog:
# Verbose | Debug | Information | Warning | Error | Fatal
LOG_LEVEL=

# ---- PostgreSQL ----
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Порт, на котором БД видна с хоста (внутри контейнера всегда 5432).
# 5432 и 5433 на машине заняты другими БД — по умолчанию берётся 5434.
POSTGRES_HOST_PORT=

# ---- MinIO (S3-совместимое хранилище фото) ----
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
# true — если MinIO за TLS. Внутри compose-сети обычно false.
MINIO_USE_SSL=

# ---- JWT ----
# Секрет HS256: минимум 32 байта случайных данных. Только здесь/в env, не в appsettings.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRES_DAYS=

# ---- Security ----
# Ключ HMAC для хеширования IP (минимум 32 байта). Сырой IP в базе не хранится.
IPHASH_KEY=

# ---- CORS ----
# Список origin через запятую, без пробелов и завершающего слэша.
# Пример: https://genesis-market.md,https://www.genesis-market.md
CORS_ALLOWED_ORIGINS=

# ---- Хост-порты сервисов (host:container) ----
# Порт API на хосте. 8080 занят сервером другого проекта → по умолчанию 8090.
API_HOST_PORT=
# Порт adminer на хосте. По умолчанию 8081.
ADMINER_HOST_PORT=
