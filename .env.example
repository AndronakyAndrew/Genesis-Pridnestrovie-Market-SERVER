# ============================================================
#  Genesis Market — пример переменных окружения.
#  Скопируй в .env и заполни значения. .env в .gitignore.
#  ООО «Genesis Industries Corp»
#
#  НЕ добавляй сюда/в .env переменную I_CONFIRM_PROD_LAUNCH — это
#  намеренно: docker-compose.yml требует её явно в команде запуска
#  (защита от случайного «голого» docker compose up), см. комментарий
#  в начале docker-compose.yml. Если она осядет в .env — перестанет
#  защищать, т.к. .env подхватывается автоматически.
# ============================================================

# ---- ASP.NET Core ----
# Development включает Swagger и стектрейсы в ошибках. Для ПУБЛИЧНОГО доступа (ngrok и т.п.)
# ставь Production: Swagger закрыт, ошибки без стектрейсов, включается валидация конфигурации.
# Публичный запуск на ноутбуке — см. README, раздел «Публичный запуск через ngrok».
ASPNETCORE_ENVIRONMENT=
# Порт, который слушает Kestrel ВНУТРИ контейнера (default 8080).
ASPNETCORE_HTTP_PORTS=

# Минимальный уровень логирования Serilog:
# Verbose | Debug | Information | Warning | Error | Fatal
LOG_LEVEL=

# ---- PostgreSQL ----
# POSTGRES_USER — владелец схемы (в образе postgres это суперпользователь).
# Под ним ходят ТОЛЬКО миграции (scripts/migrate.sh), не приложение.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Ограниченная роль приложения: только SELECT/INSERT/UPDATE/DELETE, без DDL.
# Создаётся один раз — см. scripts/create-app-role.sql (там же команда запуска).
# Пока не заданы, API откатывается на POSTGRES_USER выше, то есть работает
# суперпользователем — так быть не должно, заполните после создания роли.
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=

# Порт БД на хосте больше не публикуется (см. docker-compose.yml): снаружи база
# не нужна никому. Доступ — docker exec -it genesis-postgres psql ...
# Переменная оставлена для docker-compose.dev.yml и внешних инструментов.
POSTGRES_HOST_PORT=

# ---- MinIO (S3-совместимое хранилище фото) ----
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
# true — если MinIO за TLS. Внутри compose-сети обычно false.
MINIO_USE_SSL=

# ---- JWT ----
# Секрет HS256: минимум 32 байта случайных данных. Только здесь/в env, не в appsettings.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRES_DAYS=

# ---- Security ----
# Ключ HMAC для хеширования IP (минимум 32 байта). Сырой IP в базе не хранится.
IPHASH_KEY=

# ---- SMTP (письма подтверждения почты) ----
# ОБЯЗАТЕЛЬНО вне Development: с пустым SMTP_HOST приложение НЕ стартует.
# Раньше оно молча писало код подтверждения и адрес получателя в лог — это
# и утечка персональных данных, и путь к захвату аккаунта. Пароль — только здесь/в env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@genesis-hq.com
SMTP_FROM_NAME=Genesis Market
SMTP_USE_SSL=true

# ---- Resend (уведомления о новых обращениях из формы обратной связи) ----
# ОБЯЗАТЕЛЬНО вне Development: с пустым ключом приложение НЕ стартует (иначе
# обращения с контактами отправителей писались бы в лог). Ключ — только здесь/в env.
# Получить ключ: resend.com -> API Keys. FROM_EMAIL — адрес отправителя; ЕГО ДОМЕН должен быть
# подтверждён в панели Resend (Domains -> Add Domain, DNS-записи SPF/DKIM/DMARC) — иначе Resend
# отклонит отправку. Дефолтный onboarding@resend.dev годится только для разработки, не для прода.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Genesis Market <noreply@genesis-market.com>
FEEDBACK_NOTIFICATION_EMAIL=feedback@genesis-market.com

# ---- Telegram (уведомления и посты об объявлениях, transactional outbox) ----
# Пусто -> Telegram-клиент пишет в лог (dev), доставка идёт почтой. Токен — только в env.
# BROADCAST_CHAT_ID — общий (fallback) канал для постов об опубликованных объявлениях (шаг 16).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BROADCAST_CHAT_ID=
# Публичный адрес фронтенда для ссылок в постах, например https://genesis-market.pmr
TELEGRAM_WEB_BASE_URL=
# Маршрутизация «категория -> отдельный канал» (иначе общий канал выше). Значения — chatId
# каналов, ключ — значение категории в БД. Раскомментируйте нужные:
# Telegram__CategoryChannels__realestate=-1001111111111
# Telegram__CategoryChannels__transport=-1002222222222

# ---- SEO / индексация ----
# Публичный адрес сайта для канонических ссылок, sitemap.xml, og-тегов и JSON-LD.
# Пусто -> /api/listings/{id}/meta, /sitemap.xml и посадочные отдают 503. Обычно равен
# адресу фронтенда (тот же, что TELEGRAM_WEB_BASE_URL), сейчас https://gn-market.vercel.app
SEO_WEB_BASE_URL=
SEO_SITE_NAME=Genesis Market
# Алиас: тот же адрес одной переменной без двойного подчёркивания. Используется,
# только если SEO_WEB_BASE_URL пуст.
SITE_BASE_URL=

# ---- Публикация ----
# Что обязательно для публикации объявлений: None | Email | Phone | Both.
PUBLISHING_REQUIRED_VERIFICATION=Email

# ---- CORS ----
# Список origin через запятую, без пробелов и завершающего слэша.
# Пример: https://genesis-market.md,https://www.genesis-market.md
CORS_ALLOWED_ORIGINS=

# ---- Обратный прокси (Caddy как TLS-терминатор) ----
# Доверенные сети/адреса прокси. Без них RemoteIpAddress = адрес прокси, и rate-limit/журнал
# считали бы всех клиентов одним IP, а HSTS не выставлялся бы. По умолчанию доверяем
# docker-мосту. Для конкретных IP прокси — TRUSTED_PROXY_IPS (через запятую).
TRUSTED_PROXY_NETWORKS=172.16.0.0/12
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_FORWARD_LIMIT=1

# ---- Защита от ботов / rate-limit ----
# Лимиты на один реальный IP. При превышении API отвечает 429 + Retry-After.
# Не устанавливайте ниже 60 без проверки фронтенда: один пользователь может открыть
# несколько вкладок. Для публичного ngrok рекомендуемые значения оставлены ниже.
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_SENSITIVE_ANON_PER_HOUR=3
RATE_LIMIT_CREATE_LISTING_PER_HOUR=10
RATE_LIMIT_FEEDBACK_ANON_PER_HOUR=5
RATE_LIMIT_FEEDBACK_USER_PER_HOUR=20

# ---- OpenTelemetry ----
# Адрес OTLP-коллектора (например http://otel-collector:4317). Пусто -> экспорт выключен,
# инструментация работает вхолостую (коллектор можно добавить позже без изменения кода).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Резервные копии (scripts/backup.sh) ----
# Сколько суток хранить дампы pg_dump. По умолчанию 14.
BACKUP_RETENTION_DAYS=14

# ---- Обратный прокси Caddy (docker-compose.proxy.yml) ----
# Единственный сервис, смотрящий в интернет. Caddy сам выпускает и продлевает
# сертификат Let's Encrypt, сам редиректит HTTP→HTTPS, TLS 1.0/1.1 не поддерживает.
# Домен должен резолвиться A/AAAA-записью на этот сервер — иначе ACME не пройдёт.
PUBLIC_DOMAIN=
ACME_EMAIL=

# ---- Лимиты Kestrel ----
# Потолок тела запроса: самый крупный легитимный запрос — фото 10 МБ + обёртка формы.
KESTREL_MAX_BODY_BYTES=12582912
KESTREL_MAX_HEADERS_BYTES=32768
KESTREL_KEEPALIVE_SECONDS=120
KESTREL_HEADERS_TIMEOUT_SECONDS=30

# ---- Хост-порты сервисов (host:container) ----
# Порт API на хосте. Публикуется ТОЛЬКО на 127.0.0.1 — снаружи API доступен
# через Caddy (443) или туннель ngrok, который тоже цепляется к loopback.
API_HOST_PORT=
# ADMINER_HOST_PORT больше не используется: adminer из прод-стека удалён
# (веб-клиент БД в интернете = готовый вход в базу). Он есть только в
# docker-compose.dev.yml на порту 8082.
