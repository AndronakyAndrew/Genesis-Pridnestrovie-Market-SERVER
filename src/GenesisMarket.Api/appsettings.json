{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Postgres": {
    "Host": "",
    "Port": "5432",
    "Database": "",
    "User": "",
    "Password": ""
  },
  "Minio": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "",
    "UseSsl": false
  },
  "Jwt": {
    "Issuer": "genesis-market",
    "Audience": "genesis-market",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SecurityStampCacheSeconds": 30
  },
  "Bcrypt": {
    "WorkFactor": 12
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": "no-reply@genesis-hq.com",
    "FromName": "Genesis Market",
    "UseSsl": true
  },
  "Publishing": {
    "RequiredVerification": "Email"
  },
  "Listings": {
    "MaxActivePerUser": 30,
    "MaxPrice": 100000000,
    "MinPublishedForAutoActive": 3,
    "MinAccountAgeDays": 7,
    "ViewThrottleMinutes": 60
  },
  "AllowedHosts": "*"
}
