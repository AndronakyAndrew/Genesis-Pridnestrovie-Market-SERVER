  "Telegram": {
    "BotToken": "",
    "BroadcastChatId": "",
    "WebBaseUrl": "",
    "CategoryChannels": {},
    "MaxMessagesPerMinutePerChat": 20,
    "MaxRateLimitWaitMs": 5000
  },
  "Seo": {
    "WebBaseUrl": "",
    "SiteName": "Местная площадка Genesis",
    "OgImageTtlDays": 7,
    "SitemapSplitThreshold": 45000,
    "SitemapPageSize": 40000,
    "SitemapCacheSeconds": 3600,
    "SitemapCacheTtlMinutes": 60
  },
  "Phone": {
    "AllowOtherCountries": false
  },
  "ContactReveal": {
    "AnonPerHour": 10,
    "UserPerHour": 30,
    "MinDelayMs": 300,
    "MaxDelayMs": 600,
    "AlertThresholdPerHour": 50
  },
  "AllowedHosts": "*"
