{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": "",
    "PreflightMaxAgeSeconds": 86400
  },
  "Postgres": {
    "Host": "",
    "Port": "5432",
    "Database": "",
    "User": "",
    "Password": ""
  },
  "Minio": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "",
    "UseSsl": false
  },
  "Jwt": {
    "Issuer": "genesis-market",
    "Audience": "genesis-market",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SecurityStampCacheSeconds": 30
  },
  "Bcrypt": {
    "WorkFactor": 12
  },
  "Verification": {
    "CodeLength": 6,
    "CodeTtlMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "PasswordReset": {
    "TokenTtlMinutes": 30,
    "ResendCooldownSeconds": 60,
    "ResetPath": "/reset-password"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": "no-reply@genesis-hq.com",
    "FromName": "Местная площадка Genesis",
    "UseSsl": true
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "",
    "NotificationEmail": "feedback@genesis-market.com"
  },
  "Publishing": {
    "RequiredVerification": "Email"
  },
  "Listings": {
    "MaxActivePerUser": 30,
    "MaxPrice": 100000000,
    "ViewThrottleMinutes": 60
  },
  "Moderation": {
    "AutoPublishScore": 60,
    "PostReviewScore": 40,
    "PostModerationEnabled": true,
    "ApprovedListingPoints": 15,
    "MaxApprovedListingsCounted": 5,
    "MinApprovedForAutoPublish": 1,
    "AccountAgeDayPoints": 1,
    "MaxAccountAgeDaysCounted": 30,
    "EmailVerifiedPoints": 10,
    "PhoneVerifiedPoints": 25,
    "GoodRatingPoints": 15,
    "MinReviewsForRatingBonus": 3,
    "MinRatingForBonus": 4.0,
    "MaxAuthorTrust": 85,
    "PreReviewAfterReject": true,
    "PreReviewOnStopWord": true,
    "ExternalLinkPoints": 30,
    "ContactInTextPoints": 20,
    "StopWordPoints": 50,
    "HighPricePoints": 25,
    "HighPriceThreshold": 100000,
    "RiskyCategoryPoints": 20,
    "RiskyCategories": [ "RealEstate", "Transport", "Work", "Services" ],
    "NoImagesPoints": 10,
    "MaxQueuePriority": 50
  },
  "CatalogHygiene": {
    "ArchiveAfterDays": 30,
    "WarnBeforeDays": 3,
    "BumpCooldownDays": 7,
    "SoldReactivationDays": 7,
    "RestoreWithinDays": 90,
    "RejectLookbackDays": 30,
    "BatchSize": 200
  },
  "Scheduling": {
    "Enabled": true,
    "HygieneCron": "0 0 3 * * ?"
  },
  "Outbox": {
    "DispatchIntervalSeconds": 10,
    "BatchSize": 50,
    "CleanupCron": "0 30 3 * * ?",
    "RetentionDays": 30
  },
  "SavedSearch": {
    "NotificationCron": "0 0/15 * * * ?",
    "BatchSize": 200,
    "MaxListingsPerNotification": 10,
    "MinNotificationIntervalMinutes": 60,
    "MaxActivePerUser": 10
