<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GenesisMarket.Infrastructure\GenesisMarket.Infrastructure.csproj" />
    <ProjectReference Include="..\GenesisMarket.Domain\GenesisMarket.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Аутентификация: валидация собственных JWT (HS256) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!-- Валидация входных DTO (объявления) -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- Serilog: структурированный JSON в консоль -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Swagger (только Development, см. Program.cs) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

    <!-- Health checks UI-контракт (для JSON-ответа /health/*) -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />

    <!-- Ретраи обращений к Telegram Bot API (429 с учётом retry_after, транзиентные сбои) -->
    <PackageReference Include="Polly" Version="7.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Шаблон письма с кодом и встроенный (cid) логотип -->
    <EmbeddedResource Include="Auth\EmailTemplates\verification-code.html" />
    <EmbeddedResource Include="Auth\EmailTemplates\gm-logo.png" />
  </ItemGroup>

</Project>
