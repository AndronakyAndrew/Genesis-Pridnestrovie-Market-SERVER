<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GenesisMarket.Domain\GenesisMarket.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Блок-лист частых паролей — встроенный ресурс -->
    <EmbeddedResource Include="Auth\common-passwords.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 + Npgsql (PostgreSQL 17) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />

    <!-- Хеширование паролей (собственная аутентификация, без ASP.NET Identity) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Хранилище фото: S3-совместимый MinIO -->
    <PackageReference Include="Minio" Version="6.0.4" />
    <!-- Пин патченой версии: транзитивная 9.0.0 из Minio имеет уязвимости (NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.0" />

    <!-- Обработка изображений: валидация по содержимому, EXIF-strip, ресайз, WebP -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- Фоновые сервисы (BackgroundService/IHostedService): outbox, инициализация бакета -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />

    <!-- Health checks для readiness-проверок -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />

    <!-- Для конфигурации и DI внутри инфраструктуры -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
