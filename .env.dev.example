# ============================================================
#  Genesis Market — шаблон dev-окружения (docker-compose.dev.yml).
#  Скопируй в .env.dev и заполни значения (для локальной разработки
#  подойдут простые/фиктивные — реальные секреты сюда не нужны).
#  .env.dev в .gitignore, этот файл — нет.
#
#  Все переменные подключены к сервисам ТОЛЬКО через env_file:
#  (см. docker-compose.dev.yml) — ни одна не идёт через ${...}
#  compose-подстановку, поэтому забытый флаг --env-file не может
#  подменить их значениями из корневого (прод) .env.
# ============================================================

ENV=development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
Serilog__MinimumLevel__Default=Information

# ---- PostgreSQL ----
# POSTGRES_* читает образ postgres:17-alpine; Postgres__* — api (ASP.NET Core).
# Заполни оба одинаковыми значениями.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
Postgres__Host=postgres
Postgres__Port=5432
Postgres__Database=
Postgres__User=
Postgres__Password=

# Строки подключения для внешних инструментов (psql/adminer/dotnet ef) — api их
# не читает, см. Postgres__* выше. Подставь свои POSTGRES_*/порты из compose:
# DATABASE_URL — изнутри docker-сети (postgres:5432), DATABASE_URL_HOST — с
# хост-машины (localhost:<POSTGRES_HOST_PORT из docker-compose.dev.yml>).
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL_HOST=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5435/<POSTGRES_DB>

# Design-time подключение для `dotnet ef` (формат Npgsql keyword=value, не URL).
GENESIS_DESIGN_CONNECTION=Host=postgres;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>

# ---- MinIO (S3-совместимое хранилище фото) ----
# Держи отдельными от Postgres, даже в dev. MINIO_ROOT_* читает образ minio/minio;
# Minio__AccessKey/SecretKey — api, заполни теми же значениями.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
Minio__Endpoint=minio:9000
Minio__AccessKey=
Minio__SecretKey=
Minio__Bucket=genesis-dev
Minio__UseSsl=false

# ---- JWT ----
# Секрет HS256: минимум 32 байта случайных данных.
Jwt__Key=
Jwt__Issuer=genesis-market-dev
Jwt__Audience=genesis-market-dev
JWT_EXPIRES_DAYS=7

# ---- Security ----
# Ключ HMAC для хеширования IP (минимум 32 байта).
Security__IpHashKey=

# ---- SMTP (пусто -> письма подтверждения пишутся в лог, не отправляются) ----
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@genesis-hq.com
Smtp__FromName=Genesis Market Dev
Smtp__UseSsl=true

# ---- Telegram (пусто -> клиент пишет в лог вместо отправки) ----
Telegram__BotToken=
Telegram__BroadcastChatId=
Telegram__WebBaseUrl=http://localhost:3000

# ---- SEO ----
Seo__WebBaseUrl=http://localhost:3000
Seo__SiteName=Genesis Market Dev

# ---- Публикация ----
# None | Email | Phone | Both
Publishing__RequiredVerification=Email

# ---- CORS ----
Cors__AllowedOrigins=http://localhost:3000

# ---- Обратный прокси ----
Network__KnownNetworks=172.16.0.0/12
Network__KnownProxies=
Network__ForwardLimit=1

# ---- Rate-limit ----
RateLimit__GlobalPerMinute=120
RateLimit__SearchPerMinute=60
RateLimit__SensitiveAnonPerHour=3
RateLimit__CreateListingPerHour=10

# ---- OpenTelemetry (пусто -> экспорт выключен) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
